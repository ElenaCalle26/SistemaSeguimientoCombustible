POSTGRES_DB=combustible_db
POSTGRES_USER=combustible_user
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://combustible_user:cambia_esta_clave@db:5432/combustible_db
SECRET_KEY=reemplaza-por-una-clave-segura-y-unica
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173

# Gmail: smtp.gmail.com, puerto 587, contraseña de aplicación (no la clave normal).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
# Destinatarios reales del siguiente avance. Nunca uses Gmail inventados.
ALERT_ADMIN_EMAIL=
ALERT_SUPERVISOR_EMAIL=
ALERT_RECIPIENT=
